{
  // Copied per save to <save>/serverconfig/delvefold/ores.json.
  "schema_version": 2,
  "revision": 0,
  "profile": "custom",
  "rules": [
    {
      "id": "examplemod_tin",
      "enabled": true,
      // false lets a pack load without examplemod; the rule warns and skips.
      "required": false,
      "terrain_modes": ["flat", "cavern", "wild"],
      "targets": [
        {
          "block": "examplemod:tin_ore",
          // Optional relative output weight, 1..1000; omitted means 1.
          "weight": 2,
          "state": {},
          "replace_tag": "minecraft:stone_ore_replaceables"
        },
        {
          "block": "examplemod:deepslate_tin_ore",
          "weight": 1,
          "state": {},
          "replace_tag": "minecraft:deepslate_ore_replaceables"
        }
      ],
      "biomes": {
        "include": ["#delvefold:mining_biomes"],
        "exclude": []
      },
      "bands": [
        {
          "id": "main",
          // Optional additive schema-2 field; omitted values use classic vein placement.
          "placement": "vein",
          "vein_size": 8,
          "attempts_per_chunk": 7.5,
          "distribution": "triangle",
          "min_y": -48,
          "max_y": 96,
          "peak_y": 16,
          "plateau_min_y": null,
          "plateau_max_y": null,
          "discard_on_air_exposure": 0.25,
          "province": null
        },
        {
          "id": "regional_pockets",
          "placement": "province",
          // Retained canonical fields; ignored by the province algorithm.
          "vein_size": 1,
          "attempts_per_chunk": 0.0,
          "distribution": "triangle",
          "min_y": -48,
          "max_y": 96,
          "peak_y": 12,
          "plateau_min_y": null,
          "plateau_max_y": null,
          "discard_on_air_exposure": 0.25,
          "province": {
            "region_size": 512,
            "radius": 192,
            "vertical_thickness": 48,
            "density": 0.08,
            "per_chunk_work_cap": 256
          }
        }
      ]
    }
  ]
}
