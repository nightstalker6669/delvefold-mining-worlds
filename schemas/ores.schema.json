{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nightsta69.github.io/delvefold/schemas/ores.schema.json",
  "title": "Delvefold ore profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "profile", "rules"],
  "properties": {
    "schema_version": { "const": 2 },
    "revision": { "type": "integer", "minimum": 0 },
    "profile": { "type": "string", "minLength": 1, "maxLength": 128 },
    "rules": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/ore_rule" }
    }
  },
  "$defs": {
    "resource_location": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "selector": {
      "type": "string",
      "pattern": "^#?[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "rule_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$",
      "minLength": 1,
      "maxLength": 128
    },
    "ore_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "enabled", "required", "terrain_modes", "targets", "biomes", "bands"],
      "properties": {
        "id": { "$ref": "#/$defs/rule_id" },
        "enabled": { "type": "boolean" },
        "required": { "type": "boolean" },
        "terrain_modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["flat", "cavern", "wild"] }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/target" }
        },
        "biomes": { "$ref": "#/$defs/biome_filter" },
        "bands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/spawn_band" }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "replace_tag"],
      "properties": {
        "block": { "$ref": "#/$defs/resource_location" },
        "block_tag": { "$ref": "#/$defs/resource_location" },
        "state": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 128 }
        },
        "replace_tag": { "$ref": "#/$defs/resource_location" },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 1
        }
      },
      "oneOf": [
        { "required": ["block"], "not": { "required": ["block_tag"] } },
        { "required": ["block_tag"], "not": { "required": ["block"] } }
      ]
    },
    "biome_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/selector" }
        },
        "exclude": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/selector" }
        }
      }
    },
    "spawn_band": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "vein_size",
        "attempts_per_chunk",
        "distribution",
        "min_y",
        "max_y",
        "discard_on_air_exposure"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/rule_id" },
        "placement": {
          "enum": ["vein", "province"],
          "default": "vein",
          "description": "Placement algorithm. Omitted schema-2 values retain classic vein placement."
        },
        "vein_size": { "type": "integer", "minimum": 1, "maximum": 64 },
        "attempts_per_chunk": { "type": "number", "minimum": 0, "maximum": 256 },
        "distribution": { "enum": ["uniform", "triangle", "trapezoid"] },
        "min_y": { "type": "integer", "minimum": -64, "maximum": 320 },
        "max_y": { "type": "integer", "minimum": -64, "maximum": 320 },
        "peak_y": { "type": ["integer", "null"], "minimum": -64, "maximum": 320 },
        "plateau_min_y": { "type": ["integer", "null"], "minimum": -64, "maximum": 320 },
        "plateau_max_y": { "type": ["integer", "null"], "minimum": -64, "maximum": 320 },
        "discard_on_air_exposure": { "type": "number", "minimum": 0, "maximum": 1 },
        "province": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/province" }
          ],
          "default": null,
          "description": "Regional controls required for province placement and null for vein placement."
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["placement"],
            "properties": { "placement": { "const": "province" } }
          },
          "then": {
            "required": ["province"],
            "properties": { "province": { "$ref": "#/$defs/province" } }
          },
          "else": {
            "properties": { "province": { "type": "null" } }
          }
        },
        {
          "if": { "properties": { "distribution": { "const": "triangle" } } },
          "then": { "required": ["peak_y"] }
        },
        {
          "if": { "properties": { "distribution": { "const": "trapezoid" } } },
          "then": { "required": ["plateau_min_y", "plateau_max_y"] }
        }
      ]
    },
    "province": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_size", "radius", "vertical_thickness", "density", "per_chunk_work_cap"],
      "properties": {
        "region_size": {
          "type": "integer",
          "minimum": 16,
          "maximum": 8192,
          "multipleOf": 16,
          "default": 512
        },
        "radius": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192,
          "default": 192,
          "description": "Horizontal radius; runtime validation also requires this not to exceed region_size."
        },
        "vertical_thickness": { "type": "integer", "minimum": 1, "maximum": 385, "default": 48 },
        "density": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.08 },
        "per_chunk_work_cap": { "type": "integer", "minimum": 1, "maximum": 4096, "default": 1024 }
      }
    }
  }
}
