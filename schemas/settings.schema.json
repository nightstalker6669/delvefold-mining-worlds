{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nightsta69.github.io/delvefold/schemas/settings.schema.json",
  "title": "Delvefold world settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "generation_epoch",
    "last_world_operation_id",
    "initialized",
    "terrain_mode",
    "ore_preset",
    "active_profile_id",
    "gameplay",
    "portal"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "revision": { "type": "integer", "minimum": 0 },
    "generation_epoch": { "type": "integer", "minimum": 0 },
    "generation_salt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807,
      "default": 0
    },
    "last_world_operation_id": { "type": "string", "maxLength": 128 },
    "initialized": { "type": "boolean" },
    "terrain_mode": { "type": ["string", "null"], "enum": ["flat", "cavern", "wild", null] },
    "ore_preset": { "enum": ["vanilla_balanced", "rich", "empty"] },
    "active_profile_id": {
      "type": "string",
      "pattern": "^(?:[a-z0-9_.-]+:)?[a-z0-9_./-]+$",
      "minLength": 1,
      "maxLength": 128
    },
    "guide_visibility": {
      "enum": ["public", "operators", "disabled"],
      "default": "public"
    },
    "backup_retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "max_count", "max_age_days", "max_total_bytes"],
      "default": {
        "enabled": false,
        "max_count": 0,
        "max_age_days": 0,
        "max_total_bytes": 0
      },
      "description": "Optional automatic retention. Zero limits are unbounded and no pruning occurs unless enabled is true.",
      "properties": {
        "enabled": { "type": "boolean" },
        "max_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "max_age_days": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "max_total_bytes": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "terrain_variant", "landmark_preset", "survey_stations", "motherlodes", "fault_lines", "renewal"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "terrain_variant": { "enum": ["classic", "expansive"] },
        "geology_theme": {
          "enum": ["classic", "volcanic", "dripstone", "lush", "crystal"],
          "default": "classic",
          "description": "Recreation-locked vanilla-block geology theme. Omitted schema-2 values load as classic."
        },
        "landmark_preset": { "enum": ["pure_mining", "balanced", "abundant"] },
        "survey_stations": { "type": "boolean" },
        "motherlodes": { "type": "boolean" },
        "fault_lines": { "type": "boolean" },
        "renewal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "interval_days", "warning_minutes", "next_renewal_at_epoch_millis"],
          "properties": {
            "enabled": { "type": "boolean" },
            "interval_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
            "warning_minutes": { "type": "integer", "minimum": 1, "maximum": 10080 },
            "next_renewal_at_epoch_millis": { "type": "integer", "minimum": 0 },
            "seed_mode": {
              "enum": ["stable", "rotate_on_recreate"],
              "default": "stable"
            }
          }
        }
      }
    },
    "gameplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "monsters", "creatures", "ambient", "water_creatures", "patrols", "phantoms"],
      "properties": {
        "preset": { "enum": ["safe", "hostile", "normal"] },
        "monsters": { "type": "boolean" },
        "creatures": { "type": "boolean" },
        "ambient": { "type": "boolean" },
        "water_creatures": { "type": "boolean" },
        "patrols": { "type": "boolean" },
        "phantoms": { "type": "boolean" }
      }
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "allow_from_overworld_only", "cooldown_seconds", "coordinate_scale"],
      "properties": {
        "enabled": { "type": "boolean" },
        "allow_from_overworld_only": { "type": "boolean" },
        "cooldown_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "coordinate_scale": { "type": "number", "minimum": 0.01, "maximum": 100 },
        "routing_mode": {
          "enum": ["coordinate_linked", "central_hub"],
          "default": "coordinate_linked"
        },
        "hub": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "z", "protection_radius"],
          "default": { "x": 0, "z": 0, "protection_radius": 16 },
          "properties": {
            "x": { "type": "integer", "minimum": -29999936, "maximum": 29999936 },
            "z": { "type": "integer", "minimum": -29999936, "maximum": 29999936 },
            "protection_radius": { "type": "integer", "minimum": 8, "maximum": 256 }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "initialized": { "const": true } } },
      "then": { "properties": { "terrain_mode": { "enum": ["flat", "cavern", "wild"] } } }
    },
    {
      "if": { "properties": { "initialized": { "const": false } } },
      "then": { "properties": { "terrain_mode": { "type": "null" } } }
    }
  ]
}
