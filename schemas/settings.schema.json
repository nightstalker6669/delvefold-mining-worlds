{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nightsta69.github.io/delvefold/schemas/settings.schema.json",
  "title": "Delvefold world settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "generation_epoch",
    "last_world_operation_id",
    "initialized",
    "terrain_mode",
    "ore_preset",
    "active_profile_id",
    "gameplay",
    "portal"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "revision": { "type": "integer", "minimum": 0 },
    "generation_epoch": { "type": "integer", "minimum": 0 },
    "last_world_operation_id": { "type": "string", "maxLength": 128 },
    "initialized": { "type": "boolean" },
    "terrain_mode": { "type": ["string", "null"], "enum": ["flat", "cavern", "wild", null] },
    "ore_preset": { "enum": ["vanilla_balanced", "rich", "empty"] },
    "active_profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$",
      "minLength": 1,
      "maxLength": 128
    },
    "gameplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "monsters", "creatures", "ambient", "water_creatures", "patrols", "phantoms"],
      "properties": {
        "preset": { "enum": ["safe", "hostile", "normal"] },
        "monsters": { "type": "boolean" },
        "creatures": { "type": "boolean" },
        "ambient": { "type": "boolean" },
        "water_creatures": { "type": "boolean" },
        "patrols": { "type": "boolean" },
        "phantoms": { "type": "boolean" }
      }
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "allow_from_overworld_only", "cooldown_seconds", "coordinate_scale"],
      "properties": {
        "enabled": { "type": "boolean" },
        "allow_from_overworld_only": { "type": "boolean" },
        "cooldown_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "coordinate_scale": { "type": "number", "minimum": 0.01, "maximum": 100 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "initialized": { "const": true } } },
      "then": { "properties": { "terrain_mode": { "enum": ["flat", "cavern", "wild"] } } }
    },
    {
      "if": { "properties": { "initialized": { "const": false } } },
      "then": { "properties": { "terrain_mode": { "type": "null" } } }
    }
  ]
}
